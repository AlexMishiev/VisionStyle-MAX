# Настройки MAX-бота. Файл frontend/.env.max создаётся при первом запуске.
# Обязательно заполнить: MAX_BOT_TOKEN, API_USERNAME, API_PASSWORD.
# У учётной записи в API должна быть роль bot:max.
MAX_BOT_TOKEN=
API_BASE_URL=https://localhost:8000
# путь к cert.pem от backend, если пусто - используются системные сертификаты
API_TLS_CA_FILE=bot/assets/tls/cert.pem
API_USERNAME=
API_PASSWORD=
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

MAX_API_BASE_URL=https://platform-api2.max.ru
# если пусто, используется сертификат из bot/assets/tls
MAX_TLS_CA_FILE=
MAX_MODE=polling
# нужны только для MAX_MODE=webhook
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_HOST=127.0.0.1
MAX_WEBHOOK_PORT=8081
