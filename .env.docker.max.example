# Настройки MAX-бота для docker compose, скопируйте в .env.docker.max
# Обязательно заполнить: MAX_BOT_TOKEN, API_USERNAME, API_PASSWORD.
# У учётной записи в API должна быть роль bot:max.
MAX_BOT_TOKEN=
# адрес backend API, host.docker.internal - это компьютер, на котором запущен docker
API_BASE_URL=https://host.docker.internal:8000
# cert.pem от backend положить в frontend/bot/assets/tls/, если пусто - используются системные сертификаты
API_TLS_CA_FILE=bot/assets/tls/cert.pem
API_USERNAME=
API_PASSWORD=
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

MAX_API_BASE_URL=https://platform-api2.max.ru
# если пусто, используется сертификат из bot/assets/tls
MAX_TLS_CA_FILE=
MAX_MODE=polling
# нужны только для MAX_MODE=webhook, адрес например https://bot.smartwardrobe.space/max
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
# в docker бот должен слушать 0.0.0.0, иначе nginx до него не достучится
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8081

# Для webhook: домен бота и почта для Let's Encrypt (на неё приходят письма о сертификате).
# Домен должен вести на этот сервер, порты 80 и 443 должны быть свободны.
WEBHOOK_DOMAIN=
CERTBOT_EMAIL=
# 1 - тестовый сертификат Let's Encrypt (для проверки, MAX его не примет)
CERTBOT_STAGING=0
